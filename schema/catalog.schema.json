{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/404404/UniFi_Catalog/schema/catalog.schema.json",
  "title": "UniFi Catalog bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": 2},
    "models": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "model.schema.json"},
          {"$ref": "model-v2.schema.json"}
        ]
      }
    }
  }
}
