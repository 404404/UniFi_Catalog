{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/404404/UniFi_Catalog/schema/evidence.schema.json",
  "title": "UniFi Catalog evidence v1",
  "oneOf": [
    {"$ref": "#/$defs/official_spec"},
    {"$ref": "#/$defs/runtime_observation"}
  ],
  "$defs": {
    "official_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "canonical_sku", "sources", "fields_supported", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^official-[a-z0-9-]+$"},
        "kind": {"const": "official_spec"},
        "canonical_sku": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "publisher", "title", "retrieved_on", "evidence_note"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "publisher": {"const": "Ubiquiti"},
              "title": {"type": "string", "minLength": 1},
              "retrieved_on": {"type": "string", "format": "date"},
              "evidence_note": {"type": "string", "minLength": 1}
            }
          }
        },
        "fields_supported": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "runtime_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "supports", "observed_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^runtime-[a-z0-9-]+$"},
        "kind": {"enum": ["qualified_controller", "qualified_ssh"]},
        "supports": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "api_model": {"type": "string", "minLength": 1},
            "sysid": {"type": "string", "minLength": 1},
            "ssh_model": {"type": "string", "minLength": 1}
          }
        },
        "observed_on": {"type": "string", "format": "date"},
        "source_note": {"type": "string"}
      }
    }
  }
}
